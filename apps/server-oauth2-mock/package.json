{
	"name": "@apps/server-oauth2-mock",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --build",
		"dev": "pnpm exec portless mock-auth.inventra.localhost --force node start-dev.ts",
		"dev:worktree": "pnpm exec portless mock-auth.inventra.${WORKTREE_NAME}.localhost --force node start-dev.ts",
		"start": "node dist/index.js",
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"clean": "rimraf dist"
	},
	"dependencies": { "@cellix/server-oauth2-mock-seedwork": "workspace:*" },
	"devDependencies": {
		"@cellix/local-dev": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"@types/node": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:"
	}
}
