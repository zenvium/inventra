{
	"name": "@apps/ui-customer",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm exec portless customer.inventra.localhost --force node start-dev.ts",
		"dev:worktree": "pnpm exec portless customer.inventra.${WORKTREE_NAME}.localhost --force node start-dev.ts",
		"build": "tsc --noEmit && vite build",
		"start": "vite",
		"preview": "vite preview",
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@cellix/local-dev": "workspace:*",
		"@dr.pogodin/react-helmet": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router-dom": "catalog:",
		"react-oidc-context": "catalog:"
	},
	"devDependencies": {
		"@cellix/config-typescript": "workspace:*",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
