{
	"extends": "@cellix/config-typescript/node",
	"compilerOptions": {
		"composite": true,
		"rootDir": "src",
		"outDir": "dist",
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
		"lib": [
			"ES2023",
			"DOM"
		]
	},
	"include": [
		"src/**/*.ts"
	],
	"references": [
		{
			"path": "../application-services"
		},
		{
			"path": "../graphql"
		},
		{
			"path": "../../cellix/service-apollo-server"
		}
	]
}
